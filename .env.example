# Public process name shown in FastAPI/OpenAPI metadata.
APP_NAME=User Management API
# Runtime mode controls production-only safety validation.
ENVIRONMENT=local

# Local Docker PostgreSQL settings. Keep these values in the ignored .env file.
POSTGRES_DB=user_management
POSTGRES_USER=anthropic
POSTGRES_PASSWORD=<choose-a-local-database-password>

# Async PostgreSQL URL consumed by SQLAlchemy and Alembic.
DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:5432/${POSTGRES_DB}
# Credentialed browser origins allowed to call the API.
FRONTEND_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:3001","http://127.0.0.1:3001","http://localhost:3002","http://127.0.0.1:3002"]
# Hosts accepted by TrustedHostMiddleware.
TRUSTED_HOSTS=["localhost","127.0.0.1","testserver"]
# Only these proxy IPs may supply X-Forwarded-For values.
TRUSTED_PROXY_IPS=[]
# HttpOnly session cookie and request-correlation settings.
REQUEST_ID_HEADER=X-Request-ID
SESSION_COOKIE_NAME=session_id
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAME_SITE=lax
SESSION_TTL_SECONDS=3600
# Global and login-specific fixed-window rate limits.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_LOGIN_REQUESTS=5
# Optional local administrator bootstrap. Use a secret outside source control.
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=<choose-a-local-admin-password>
BOOTSTRAP_ADMIN_NAME=Administrator
BOOTSTRAP_ADMIN_BIRTH_DATE=1980-01-01
# Leave empty for local in-memory limiting; configure Redis in staging/production.
REDIS_URL=
